/*
    MINI GAME PROJECT - TIC TAC TOE
    ----------------------------------
    Console-based 2-player Tic Tac Toe. Demonstrates loops, arrays,
    and conditional logic. Displays board dynamically, detects
    win/loss/draw, and offers a replay option.

    Compile: g++ -std=c++17 -o tic_tac_toe tic_tac_toe.cpp
    Run:     ./tic_tac_toe
*/

#include <iostream>
#include <limits>

using namespace std;

char board[3][3];

void initBoard() {
    int cellNumber = 1;
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            board[i][j] = '0' + cellNumber++; // fill with 1-9 initially
}

void displayBoard() {
    cout << "\n";
    for (int i = 0; i < 3; i++) {
        cout << " " << board[i][0] << " | " << board[i][1] << " | " << board[i][2] << " \n";
        if (i < 2) cout << "---|---|---\n";
    }
    cout << "\n";
}

void clearInputBuffer() {
    cin.clear();
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
}

int getMoveInput(const string &playerSymbol) {
    int move;
    while (true) {
        cout << "Player " << playerSymbol << ", enter cell number (1-9): ";
        cin >> move;
        if (cin.fail()) {
            cout << "Invalid input. Please enter a number between 1 and 9.\n";
            clearInputBuffer();
            continue;
        }
        if (move < 1 || move > 9) {
            cout << "Please choose a number between 1 and 9.\n";
            continue;
        }

        int row = (move - 1) / 3;
        int col = (move - 1) % 3;

        if (board[row][col] == 'X' || board[row][col] == 'O') {
            cout << "That cell is already taken. Choose another.\n";
            continue;
        }

        return move;
    }
}

void markCell(int move, char symbol) {
    int row = (move - 1) / 3;
    int col = (move - 1) % 3;
    board[row][col] = symbol;
}

// Returns 'X' or 'O' if that player won, 'D' for draw, ' ' if game continues
char checkGameStatus(int movesPlayed) {
    // Check rows and columns
    for (int i = 0; i < 3; i++) {
        if (board[i][0] == board[i][1] && board[i][1] == board[i][2])
            return board[i][0];
        if (board[0][i] == board[1][i] && board[1][i] == board[2][i])
            return board[0][i];
    }
    // Check diagonals
    if (board[0][0] == board[1][1] && board[1][1] == board[2][2])
        return board[0][0];
    if (board[0][2] == board[1][1] && board[1][1] == board[2][0])
        return board[0][2];

    // Draw
    if (movesPlayed == 9) return 'D';

    return ' '; // game continues
}

void playGame() {
    initBoard();
    char currentPlayer = 'X';
    int movesPlayed = 0;
    char result = ' ';

    displayBoard();

    while (true) {
        int move = getMoveInput(string(1, currentPlayer));
        markCell(move, currentPlayer);
        movesPlayed++;

        displayBoard();

        result = checkGameStatus(movesPlayed);

        if (result == 'X' || result == 'O') {
            cout << "*** Player " << result << " wins! Congratulations! ***\n";
            break;
        }
        if (result == 'D') {
            cout << "*** It's a draw! Well played, both! ***\n";
            break;
        }

        // Switch turns
        currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
    }
}

int main() {
    char playAgain;

    cout << "=========================================\n";
    cout << "         TIC TAC TOE - CONSOLE GAME       \n";
    cout << "=========================================\n";
    cout << "Player 1 = X   |   Player 2 = O\n";
    cout << "Cells are numbered 1-9 as shown below:\n";
    cout << " 1 | 2 | 3 \n---|---|---\n 4 | 5 | 6 \n---|---|---\n 7 | 8 | 9 \n";

    do {
        playGame();

        cout << "Play again? (y/n): ";
        cin >> playAgain;
        clearInputBuffer();

    } while (playAgain == 'y' || playAgain == 'Y');

    cout << "Thanks for playing! Goodbye.\n";
    return 0;
}
